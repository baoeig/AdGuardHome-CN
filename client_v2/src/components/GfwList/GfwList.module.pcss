.card {
    display: grid;
    gap: 16px;
    margin: 16px;
    padding: 20px;
    border-radius: 12px;
    background: var(--default-cards-background);
}

.card p {
    margin: 0;
}

.actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}

.domains {
    margin: 0;
    padding: 0;
    list-style: none;
}

.domain {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-items: center;
    gap: 8px;
    padding: 8px 0;
    border-top: 1px solid var(--default-item-divider);
}

.domain > span {
    overflow-wrap: anywhere;
}
